# .env.example: every environment variable Metis-Auto reads (ADR-0019).
# Committed, with placeholders only. NO REAL SECRETS.
#
# How to use: copy to .env (git-ignored: `cp .env.example .env`), then fill in
# only what you need. Nothing here is required to run the tests or the walking
# skeleton. The process environment wins over .env.
#
# Two kinds of variables:
#   1. Secrets: plain names (METIS_API_KEY, ...). Only from the environment
#      or .env; never in a config file; never logged, hashed, or put in events.
#   2. Settings overrides: METIS__<SECTION>__<KEY>=value (double underscores).
#      They override config/defaults.toml, an experiment file, and
#      config/local.toml. Values are TOML literals (true, 0.5, "text",
#      [0.5, 0.8]); anything else is read as a plain string.
#
# Full precedence and rules: docs/architecture/configuration.md.

# ---------------------------------------------------------------------------
# 1. Secrets
# ---------------------------------------------------------------------------

# Metis API key: the ONE credential for every model family (OpenAI, DeepSeek,
# Grok, later Gemini) through the Metis wrapper (docs/references/metis_wrapper_api.md).
# Get it from the Metis dashboard. Development and testing only, under the
# 20 USD lifetime budget (ADR-0018). Paste it after "=" with no quotes.
# Having the key does NOT enable live calls; see METIS__LIVE__ENABLED below.
METIS_API_KEY=

# Direct provider keys (OPENAI_API_KEY, DEEPSEEK_API_KEY, XAI_API_KEY,
# GEMINI_API_KEY) are NOT used: every call goes through the Metis wrapper.

# Fingerprint key (ADR-0015): at least 32 bytes, hex-encoded (64+ hex chars).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Share it out of band with teammates whose runs must be comparable (Q-20).
# Unset: a random key per process (fingerprints then don't compare across runs).
# METIS_FINGERPRINT_KEY=

# Future PostgreSQL password (Stage 9). Also used by the optional `postgres`
# service in compose.yaml (`docker compose --profile db up`).
# METIS_DB_PASSWORD=

# ---------------------------------------------------------------------------
# 2. Where configuration lives
# ---------------------------------------------------------------------------

# Config directory (defaults.toml, reference/, profiles/). Default: <checkout>/config.
# The container sets /app/config.
# METIS_CONFIG_DIR=config

# Runtime config file (machine-specific). Default: config/local.toml if present.
# Start from config/local.example.toml.
# METIS_RUNTIME_CONFIG=config/local.toml

# ---------------------------------------------------------------------------
# 3. Live calls and budget (ADR-0003, ADR-0018)
# ---------------------------------------------------------------------------

# Second key for live calls on this machine (the first is an experiment asking
# for counterfactual_source = "live"). Default false. No live client exists
# before Stage 7.5.
# METIS__LIVE__ENABLED=false

# Lifetime cap across ALL runs, in USD. Default "20". Can never exceed the
# 20 USD ceiling, which only config/defaults.toml may set.
# METIS__BUDGET__LIFETIME_CAP="20"

# Per-run cap, in USD (<= lifetime cap). Default "1".
# METIS__BUDGET__RUN_CAP="1"

# Warn when lifetime spend crosses these fractions. Default [0.5, 0.8].
# METIS__BUDGET__WARN_AT=[0.5, 0.8]

# Persistent spend ledger (git-ignored). NEVER delete it: that resets the
# lifetime total. Default data/spend/ledger.jsonl.
# METIS__PATHS__SPEND_LEDGER=data/spend/ledger.jsonl

# ---------------------------------------------------------------------------
# 4. Model catalogue and reference data (paths relative to METIS_CONFIG_DIR)
# ---------------------------------------------------------------------------

# METIS__REFERENCE__CATALOGUE=reference/catalogue-metis-test.toml
# METIS__REFERENCE__PRICES=reference/prices-metis-2026-10-18.toml
# METIS__REFERENCE__ENDPOINTS=reference/endpoints-metis.toml
# METIS__REFERENCE__BASELINES=reference/baselines.toml

# ---------------------------------------------------------------------------
# 5. Pipeline policies: cache, routing, context (any [pipeline.*] key)
# ---------------------------------------------------------------------------

# Routing policy (promoted policies only) and its target.
# METIS__PIPELINE__ROUTING__POLICY=fixed_model
# METIS__PIPELINE__ROUTING__FIXED_MODEL__MODEL_ID=gpt-4o-mini

# Cache settings: any field of the cache policy config (domain/caching),
# for example the entry lifetime in seconds.
# METIS__PIPELINE__CACHE__TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# 6. Embeddings (semantic tier, Stage 8)
# ---------------------------------------------------------------------------

# METIS__EMBEDDING__BACKEND=fake
# METIS__EMBEDDING__MODEL=

# ---------------------------------------------------------------------------
# 7. Database (future PostgreSQL, Stage 9; nothing reads it yet)
# ---------------------------------------------------------------------------

# METIS__DATABASE__ENABLED=false
# METIS__DATABASE__HOST=localhost
# METIS__DATABASE__PORT=5432
# METIS__DATABASE__NAME=metis
# METIS__DATABASE__USER=metis

# ---------------------------------------------------------------------------
# 8. Experiment, logging, local development
# ---------------------------------------------------------------------------

# Answer source: fake | logged_match | recorded | live | proxy (ADR-0014).
# METIS__EXPERIMENT__COUNTERFACTUAL_SOURCE=fake
# METIS__EXPERIMENT__SEED=0

# Operator log level: DEBUG | INFO | WARNING | ERROR. Logs never hold content.
# METIS__LOGGING__LEVEL=INFO

# Run records directory (git-ignored).
# METIS__PATHS__RUN_DIR=runs

# Without METIS_FINGERPRINT_KEY: true = random key per process; false = refuse.
# METIS__DEV__EPHEMERAL_FINGERPRINT_KEY=true
